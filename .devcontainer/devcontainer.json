{
  "name": "obsidian-d2-standalone",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
  "mounts": [
    "source=obsidian-d2-standalone-node-modules,target=/workspaces/obsidian-d2-standalone/node_modules,type=volume"
  ],
  "remoteUser": "node",
  "postCreateCommand": "sudo chown -R node:node /workspaces/obsidian-d2-standalone/node_modules",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
